<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.5</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.gudnuz</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!--
		Surcharge des versions gérées par spring-boot-starter-parent (4.0.5, pas de version
		stable plus récente disponible pour l'instant) pour appliquer deux correctifs de
		sécurité en attendant une prochaine version de Spring Boot :
		- CVE-2026-41293 (Tomcat) : validation des en-têtes HTTP/2, CVSS 9.8.
		- CVE-2026-41855 (Spring Framework) : désérialisation non sûre via JMS/Jackson.
		  Non exploitable ici (GudNuz n'utilise pas JMS), corrigée quand même car gratuite.
		Voir dependency-check-suppressions.xml pour les CVE non corrigeables pour l'instant.
		-->
		<tomcat.version>11.0.22</tomcat.version>
		<!-- 7.0.9 corrige aussi CVE-2026-59283 (SpEL, non exploitable ici de toute façon : pas
		     d'usage de SpelExpressionParser/SimpleEvaluationContext, compiler mode jamais activé) -->
		<spring-framework.version>7.0.9</spring-framework.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.23.2</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>com.google.firebase</groupId>
			<artifactId>firebase-admin</artifactId>
			<version>9.11.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.15</version>
				<executions>
					<execution>
						<!-- Instrumente la JVM avant les tests pour pouvoir mesurer la couverture -->
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<!-- Génère le rapport HTML/XML dans target/site/jacoco après les tests -->
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!--
				OWASP Dependency-Check : scanne les dépendances (pom.xml) contre la base CVE du NIST.
				Volontairement PAS bindé à une phase du cycle de vie (pas d'<executions> ici) : la synchro
				de la base CVE peut être lente/rate-limitée sans clé API, donc on ne veut pas ralentir
				un simple `mvn verify` en local. Invoqué explicitement par le workflow dédié
				`.github/workflows/security-scan.yml` via `./mvnw org.owasp:dependency-check-maven:check`.
				-->
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>13.0.0</version>
				<configuration>
					<!-- 11 = ne bloque jamais le build (le CVSS max réel est 10). Le job CI
					     rend aussi ce step non bloquant côté GitHub Actions (continue-on-error) :
					     ce scan reste informatif (rapport en artefact), Dependabot fait la
					     vraie veille de sécurité en tâche de fond. Voir CLAUDE.md pour le
					     contexte de cette décision (2026-09-01). -->
					<failBuildOnCVSS>11</failBuildOnCVSS>
					<formats>
						<format>HTML</format>
					</formats>
					<suppressionFiles>
						<suppressionFile>dependency-check-suppressions.xml</suppressionFile>
					</suppressionFiles>

					<!-- Emplacement de la base CVE locale (base H2, plusieurs centaines de Mo).
					     Par défaut, le plugin la range DANS ~/.m2/repository, mélangée aux dépendances
					     Maven : impossible alors de la mettre en cache séparément en CI. En la sortant
					     dans son propre dossier, security-scan.yml peut lui donner un cache dédié, avec
					     une clé adaptée à son rythme de mise à jour (au jour), indépendant du pom.xml. -->
					<dataDirectory>${user.home}/.dependency-check-data</dataDirectory>

					<!-- Analyseurs désactivés : chacun sert un autre écosystème que Java/Maven (ou
					     n'apporte rien dans un projet Maven), mais s'exécute quand même par défaut,
					     et certains font des appels réseau à chaque run. Les désactiver ne réduit pas
					     la détection sur NOS dépendances : c'est l'analyseur de JAR + la base NVD qui
					     font le vrai travail ici, et ils restent actifs. -->

					<!-- JavaScript : aucun package.json / fichier .js dans ce projet. Retire.js
					     télécharge en plus sa propre base de vulnérabilités à chaque run. -->
					<nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
					<nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
					<yarnAuditAnalyzerEnabled>false</yarnAuditAnalyzerEnabled>
					<pnpmAuditAnalyzerEnabled>false</pnpmAuditAnalyzerEnabled>
					<retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>

					<!-- .NET : aucun fichier .dll / .nuspec / projet MSBuild ici. -->
					<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
					<nuspecAnalyzerEnabled>false</nuspecAnalyzerEnabled>
					<nugetconfAnalyzerEnabled>false</nugetconfAnalyzerEnabled>
					<msbuildAnalyzerEnabled>false</msbuildAnalyzerEnabled>

					<!-- OSS Index (Sonatype) : exige désormais un compte + identifiants. Sans eux,
					     il tente quand même des appels réseau qui échouent, pour rien. -->
					<ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>

					<!-- Central Analyzer : interroge Maven Central pour chaque JAR afin de deviner
					     son groupId:artifactId:version. Inutile ici : dans un projet Maven, le plugin
					     connaît déjà ces coordonnées exactes grâce au pom.xml. Un appel réseau (et un
					     risque de rate-limiting) par dépendance en moins. -->
					<centralAnalyzerEnabled>false</centralAnalyzerEnabled>
				</configuration>
			</plugin>
			<plugin>
				<!--
				SpotBugs + Find Security Bugs : analyse statique du bytecode compilé (pas des dépendances,
				notre propre code). Goal "spotbugs" (rapport) et non "check" (bloquant) pour ce premier
				passage, même logique que ci-dessus : on veut d'abord voir ce qui remonte avant de décider
				quoi bloquer. Bindé sur "verify" car rapide (pas d'appel réseau), contrairement à
				dependency-check.
				-->
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<version>4.10.5.0</version>
				<configuration>
					<effort>Max</effort>
					<threshold>Medium</threshold>
					<plugins>
						<plugin>
							<groupId>com.h3xstream.findsecbugs</groupId>
							<artifactId>findsecbugs-plugin</artifactId>
							<version>1.14.0</version>
						</plugin>
					</plugins>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals>
							<goal>spotbugs</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
